DATABASE_URL=postgresql://rafeeq:rafeeq@localhost:5432/rafeeq
# ---- M1 orchestrator (Copilot router + Snap photo reading) -----------------
# Any OpenAI-compatible endpoint. The model must accept images for Snap.
# Check it with: uv run python -m rafeeq.copilot.check_llm
LLM_API_KEY=put-your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# M2 tutor (+ M4 quiz) -> Google
RAFEEQ_KNOWLEDGE=1
RAFEEQ_KNOWLEDGE_TUTOR=1
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- M5 teacher: lecturer assistant -------------------------------------
# Pick ONE provider and fill its key + model. Rafeeq starts without them;
# only "جهّز المسودة" on /teacher needs them.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0

# Optional: web research for the outline (Tavily MCP). Empty = the outline uses the model only.
TAVILY_API_KEY=
# Video discovery (Lab 4b): search real YouTube videos and jump to the exact timestamp.
# No key needed -- search uses youtube-search-python; GOOGLE_API_KEY above is reused for embeddings.

# Video generation (Lab 5): animated video from an image or text prompt (QwenCloud/Wan models)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://maas.qwencloudapi.com
WAN_T2V_MODEL=wan2.6-t2v
WAN_I2V_MODEL=wan2.6-i2v-flash

# How many times a teacher may send a draft back for changes
MAX_REVISIONS=3
# Where generated .pptx / code / quiz files go (default: outputs/teacher)
TEACHER_OUTPUT_DIR=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rafeeq

# Narration voice: Gemini TTS is used when GOOGLE_API_KEY is set, edge-tts is the fallback.
# TTS_PROVIDER=gemini   # or edge, to force one
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- M2 knowledge base ----------------------------------------------------
# Off by default. 1 = real /search, topics, sources and background indexing of uploaded PDFs
# (needs: uv add --optional knowledge sentence-transformers faiss-cpu ; uv sync --extra knowledge)
RAFEEQ_KNOWLEDGE=0
# 1 = also use the grounded answerer as the Copilot's tutor_answer (needs GOOGLE_API_KEY or GEMINI_API_KEY, and GEMINI_MODEL above)
RAFEEQ_KNOWLEDGE_TUTOR=0
# RAFEEQ_KNOWLEDGE_DIR=storage/knowledge/vector_store
# RAFEEQ_KNOWLEDGE_DEVICE=cpu            # or cuda
# RAFEEQ_KNOWLEDGE_RETRIEVAL=hybrid      # or dense
# RAFEEQ_KNOWLEDGE_EXCLUDE=1             # skip index-like pages
# RAFEEQ_KNOWLEDGE_RERANK=0              # 1 = add the cross-encoder reranker (downloads BAAI/bge-reranker-v2-m3)

# ---- M3 tutor (answers, quiz from material, study files, Snap explain/check) -------
# No extra model to run: the tutor uses the SAME hosted model as M1 (LLM_API_KEY / LLM_BASE_URL / LLM_MODEL above),
# for text and for reading photos (the model must accept images). Level 1 reads M2 in-process, so RAFEEQ_KNOWLEDGE=1 is all it needs.
# Level 2 and "what is X" search the web with Tavily (free key at tavily.com). Empty = the tutor answers from the material only.
TAVILY_API_KEY=
# TAVILY_MONTHLY_LIMIT=900             # stop before the free quota ends
# SNAP_READER=hosted                   # hosted (default when LLM_API_KEY is set) | ollama (local, needs `ollama pull qwen2.5vl:7b`)
# SNAP_VISION_MODEL=                   # another image model on the same endpoint
# LLM_PROVIDER=ollama                  # ONLY to run the tutor on a local Ollama model instead (OLLAMA_MODEL=qwen3:8b)
# STUDY_DATA_DIR=data/study            # chats, memory notes, study files

# ---- Demo -------------------------------------------------------------------
# Fill ONE room with demo students, quiz history and questions (rafeeq/demo_seed.py). Upload a PDF
# to the room first and wait until it is ready. Seeds once; never use on a real class.
# RAFEEQ_DEMO_ROOM=r_xxxxxxxx
